# Notion (내부 통합 토큰) — 서버 전용, 절대 NEXT_PUBLIC_ 붙이지 말 것
NOTION_TOKEN=
# npm run setup:notion -- <상위 페이지 URL> 실행 후 출력되는 데이터 소스 ID
NOTION_DS_TRIPS=
NOTION_DS_MEMBERS=
NOTION_DS_SCHEDULE=
NOTION_DS_PLACES=
NOTION_DS_EXPENSES=

# Google Maps (브라우저용 키, HTTP referrer 제한 필수)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAP_ID=

# 세션 쿠키 서명용 랜덤 문자열 (openssl rand -hex 32)
SESSION_SECRET=
